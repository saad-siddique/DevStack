#!/usr/bin/env bash
# cleanup [--json] : the databases no site owns, classified, grouped into runs, with what is safe to drop.
#   Owned (never listed): a linked site's wp-config DB_NAME, any db in the sites inventory, the system schemas.
#   throwaway = lane suffix (_single_<n> / _multisite_<n>) or a test-prefixed options table; unknown = neither.
#   sweepable = lane suffix AND test-prefixed options table. A run is the lanes of one test run (same tag).
#   locked = a live connection, or a write in the last 30 minutes; last write = the later of the newest table-file
#   mtime and information_schema UPDATE_TIME (read with the statistics cache off, or it is up to a day stale).
# Listing JSON: see docs/superpowers/specs/2026-11-02-cleanup-tab-design.md. MySQL not answering: exit 1.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

usage() {
	cat >&2 <<'USAGE'
usage: cleanup [--json]
       cleanup --drop <database|run>... [--dry-run] --yes [--json]
       cleanup --pin <run>... | --unpin <run>... [--json]
       cleanup --sweep [--dry-run] [--json]            what the nightly agent runs; silent while the sweep is off
       cleanup --enable-sweep | --disable-sweep | --older-than <hours>   (settings, kept in cleanup.json)
USAGE
	exit 2
}
ACTION=list; TARGETS=(); JSON=0; DRY_RUN=0; YES=0; MODE=""; SET_ENABLED=""; SET_HOURS=""
for arg in "$@"; do
	case "$arg" in
		--json) JSON=1 ;;
		--drop) ACTION=drop; MODE=target ;;
		--pin) ACTION=pin; MODE=target ;;
		--unpin) ACTION=unpin; MODE=target ;;
		--sweep) ACTION=sweep ;;
		--enable-sweep) ACTION=settings; SET_ENABLED=true ;;
		--disable-sweep) ACTION=settings; SET_ENABLED=false ;;
		--older-than) ACTION=settings; MODE=hours ;;
		--dry-run) DRY_RUN=1 ;;
		--yes) YES=1 ;;
		-*) usage ;;
		*)
			case "$MODE" in
				(target) TARGETS+=("$arg") ;;
				(hours) [[ "$arg" =~ ^[1-9][0-9]*$ ]] || usage; SET_HOURS="$arg"; MODE="" ;;
				(*) usage ;;
			esac ;;
	esac
done
if [ "hours" = "$MODE" ]; then usage; fi
case "$ACTION" in (drop|pin|unpin) [ "${#TARGETS[@]}" -gt 0 ] || usage ;; esac
if [ "drop" = "$ACTION" ] && [ "1" != "$YES" ] && [ "1" != "$DRY_RUN" ]; then
	echo "cleanup: --drop needs --yes (or --dry-run to see what it would do)" >&2; exit 2
fi

LANE_RE='_(single|multisite)_[0-9]+$'
NAME_RE='^[A-Za-z0-9_$-]{1,64}$'
LOCK_SECONDS=1800
STATE_FILE="$DATA_DIR/cleanup.json"
BACKUP_ROOT="${BACKUP_ROOT:-$HOME/Backups/DevStack}"

# settings_json : $DATA_DIR/cleanup.json with defaults filled in.
settings_json() {
	local raw='{}'
	if [ -f "$STATE_FILE" ]; then raw="$(cat "$STATE_FILE")"; fi
	printf '%s' "$raw" | jq -c '{sweep: ({enabled: false, older_than_hours: 48} + (.sweep // {})), pinned: (.pinned // [])}' \
		|| die "$STATE_FILE is not valid JSON"
}

# Comment lines of a wp-config.php: a commented-out define must not own a database.
COMMENT_RE='^[[:space:]]*(//|#|\*|/\*)'

# site_wp_config <docroot> : the wp-config.php WordPress itself would use: the docroot's, else the parent folder's (core
# supports that layout when the parent holds no wp-settings.php). Prints nothing for a folder that is not WordPress.
site_wp_config() {
	if [ -f "$1/wp-config.php" ]; then printf '%s' "$1/wp-config.php"
	elif [ -f "$1/../wp-config.php" ] && [ ! -f "$1/../wp-settings.php" ]; then printf '%s' "$1/../wp-config.php"; fi
}

# config_code <file> : the non-comment lines.
config_code() { LC_ALL=C grep -Ev "$COMMENT_RE" "$1" || true; }

# config_db_name <file> : the literal DB_NAME, nothing when there is none (WP-CLI is never started: files are read, not run).
config_db_name() {
	{ config_code "$1" | LC_ALL=C sed -nE "s/.*define\( *['\"]DB_NAME['\"], *['\"]([^'\"]+)['\"].*/\1/p" | head -1; } || true
}

# sites_with_config : "<site>\t<wp-config path>" for every linked WordPress site.
sites_with_config() {
	local l t c
	for l in "$VALET_HOME"/Sites/*; do
		[ -L "$l" ] || continue
		t="$(readlink "$l")"
		c="$(site_wp_config "$t")"
		if [ -n "$c" ]; then printf '%s\t%s\n' "$(basename "$l")" "$c"; fi
	done
}

# owned_dbs : database names a site owns, one per line.
owned_dbs() {
	local site cfg n
	while IFS=$'\t' read -r site cfg; do
		n="$(config_db_name "$cfg")"
		if [ -n "$n" ]; then printf '%s\n' "$n"; fi
	done < <(sites_with_config)
	if [ -f "$SITES_TSV" ]; then LC_ALL=C awk -F'\t' '!/^#/ && NF >= 4 && $4 != "" { print $4 }' "$SITES_TSV"; fi
	printf '%s\n' mysql sys information_schema performance_schema
}

# unresolved_sites : linked sites whose wp-config.php mentions DB_NAME but gives no literal name (getenv(), a constant, an
# include), so which database they own cannot be read from the file.
unresolved_sites() {
	local site cfg code
	while IFS=$'\t' read -r site cfg; do
		code="$(config_code "$cfg")"
		case "$code" in (*DB_NAME*) if [ -z "$(config_db_name "$cfg")" ]; then printf '%s\n' "$site"; fi ;; esac
	done < <(sites_with_config)
}

is_lane()    { [[ "$1" =~ $LANE_RE ]]; }
lane_tag()   { printf '%s' "$1" | sed -E "s/$LANE_RE//"; }   # the lane suffix removed; any other name unchanged
valid_name() { [[ "$1" =~ $NAME_RE ]]; }                     # what may be quoted into SQL and a file name

# db_folder <db> : the schema's folder name under the data directory (every character outside [A-Za-z0-9_] is @ + 4 hex).
db_folder() {
	local s="$1" out="" c i
	for (( i = 0; i < ${#s}; i++ )); do
		c="${s:i:1}"
		case "$c" in
			([A-Za-z0-9_]) out="$out$c" ;;
			(*) out="$out$(printf '@%04x' "'$c")" ;;
		esac
	done
	printf '%s' "$out"
}

# files_bytes <db> : bytes of the schema's table files (what dropping it frees; never mysql.ibd).
files_bytes() {
	find "$(mysql_datadir)$(db_folder "$1")" -name '*.ibd' -exec stat -f %z {} + 2> /dev/null | awk '{ s += $1 } END { print s + 0 }'
}

sql_schemas() {
	cat <<'SQL'
SET SESSION information_schema_stats_expiry = 0;
SELECT s.SCHEMA_NAME, COUNT(t.TABLE_NAME), IFNULL(UNIX_TIMESTAMP(MAX(t.UPDATE_TIME)), 0), IFNULL(UNIX_TIMESTAMP(MIN(t.CREATE_TIME)), 0),
       IFNULL(MAX(t.TABLE_NAME REGEXP '^(test|wptests).*options$'), 0)
FROM information_schema.SCHEMATA s LEFT JOIN information_schema.TABLES t ON t.TABLE_SCHEMA = s.SCHEMA_NAME
WHERE s.SCHEMA_NAME NOT IN ('mysql', 'sys', 'information_schema', 'performance_schema')
GROUP BY s.SCHEMA_NAME ORDER BY s.SCHEMA_NAME
SQL
}

# One pass over every table file: "<database>\t<newest mtime>\t<bytes>". Folder names are decoded back to database names.
files_facts() {
	local datadir="$1"
	find "$datadir" -mindepth 2 -maxdepth 2 -name '*.ibd' -exec stat -f '%m %z %N' {} + 2> /dev/null | LC_ALL=C awk -v prefix="$datadir" '
		function unhex(h,   i, n) { n = 0; for (i = 1; i <= length(h); i++) n = n * 16 + index("0123456789abcdef", substr(h, i, 1)) - 1; return n }
		function decode(s,   out) {
			out = ""
			while (match(s, /@[0-9a-f][0-9a-f][0-9a-f][0-9a-f]/)) {
				out = out substr(s, 1, RSTART - 1) sprintf("%c", unhex(substr(s, RSTART + 1, 4)))
				s = substr(s, RSTART + RLENGTH)
			}
			return out s
		}
		{
			path = $0; sub(/^[0-9]+ [0-9]+ /, "", path)
			if (index(path, prefix) == 1) path = substr(path, length(prefix) + 1)
			dir = substr(path, 1, index(path, "/") - 1)
			if ($1 + 0 > mt[dir] + 0) mt[dir] = $1
			sz[dir] += $2
		}
		END { for (d in mt) printf "%s\t%s\t%s\n", decode(d), mt[d], sz[d] }' || true
}

# scan_json : the listing, as one JSON object on stdout.
scan_json() {
	# drop_main and sweep_main run inside `if`, where errexit is off: a failed query here must not leave an empty scan that
	# reads as "nothing exists", so every command that can fail is checked by hand.
	local datadir owned schemas files conn catalog disk now settings unres
	datadir="$(mysql_datadir)" || return 1
	owned="$(owned_dbs)" || return 1
	unres="$(unresolved_sites)" || return 1
	schemas="$(mysql_new -N -e "$(sql_schemas)")" || return 1
	conn="$(mysql_new -N -e "SELECT DISTINCT DB FROM performance_schema.processlist WHERE DB IS NOT NULL")" || return 1
	catalog="$(mysql_new -N -e "SELECT TOTAL_EXTENTS * EXTENT_SIZE, FREE_EXTENTS * EXTENT_SIZE FROM information_schema.FILES WHERE FILE_NAME LIKE '%mysql.ibd' LIMIT 1")" || return 1
	files="$(files_facts "$datadir")" || return 1
	disk="$(df -k "$HOME" | awk 'NR == 2 { print $4 * 1024 }')" || return 1
	now="$(date +%s)"
	settings="$(settings_json)" || return 1
	jq -n --arg owned "$owned" --arg schemas "$schemas" --arg files "$files" --arg conn "$conn" --arg catalog "$catalog" --arg unres "$unres" \
		--arg disk "$disk" --arg now "$now" --argjson settings "$settings" --arg lane_re "$LANE_RE" --argjson lock "$LOCK_SECONDS" '
		def lines: split("\n") | map(select(length > 0));
		def rows: lines | map(split("\t"));
		def iso: if . == null or . == 0 then null else todate end;
		($owned | lines) as $own
		| ($unres | lines) as $unresolved
		| ($conn | lines) as $connected
		| ($files | rows | map({key: .[0], value: {m: (.[1] | tonumber), b: (.[2] | tonumber)}}) | from_entries) as $f
		| ($schemas | rows | map({name: .[0], upd: (.[2] | tonumber), cre: (.[3] | tonumber), topts: (.[4] == "1")})) as $all
		| ($settings.pinned) as $pinned
		| ($now | tonumber) as $now
		| ($all | map(select(.name as $n | ($own | index($n)) == null))) as $un
		| ($un | map(
			. as $d
			| ($f[$d.name] // {m: 0, b: 0}) as $fi
			| ($d.name | test($lane_re)) as $lane
			| ([$fi.m, $d.upd] | max) as $lw
			| { name: $d.name,
				tag: (if $lane then ($d.name | sub($lane_re; "")) else $d.name end),
				throwaway: (if ($unresolved | length) > 0 then ($lane and $d.topts) else ($lane or $d.topts) end),
				sweepable: ($lane and $d.topts),
				bytes: $fi.b, cre: $d.cre, lw: $lw,
				reason: (if ($connected | index($d.name)) != null then "connection"
					elif ($now - $lw) < $lock then "recent_write" else null end) }
		  )) as $dbs
		| ($dbs | group_by(.tag) | map(
			(map(.lw) | max) as $lw
			| (map(.reason) | map(select(. != null))) as $r
			| { tag: .[0].tag,
				kind: (if all(.[]; .throwaway) then "throwaway" else "unknown" end),
				sweepable: all(.[]; .sweepable),
				lanes: length,
				databases: (map(.name) | sort),
				files_bytes: (map(.bytes) | add),
				created: (map(.cre) | map(select(. > 0)) | (if length > 0 then min else null end) | iso),
				last_write: ($lw | iso),
				idle_seconds: ($now - $lw),
				state: (if ($r | length) > 0 then "locked" else "idle" end),
				locked_reason: (if ($r | index("connection")) != null then "connection" elif ($r | length) > 0 then "recent_write" else null end),
				pinned: (.[0].tag as $t | ($pinned | index($t)) != null),
				lw: $lw }
		  ) | sort_by(.lw) | map(del(.lw))) as $runs
		| { generated_at: ($now | todate),
			disk_free_bytes: ($disk | tonumber),
			mysql: { databases: ($all | length), owned: (($all | length) - ($un | length)), unowned: ($un | length),
				catalog_bytes: (($catalog | rows | .[0][0] // "0") | tonumber),
				catalog_free_bytes: (($catalog | rows | .[0][1] // "0") | tonumber) },
			sweep: ($settings.sweep + {next: ($runs | map(select(.sweepable and .state == "idle" and (.pinned | not)
				and .idle_seconds > ($settings.sweep.older_than_hours * 3600)) | .tag))}),
			pinned: $pinned,
			warnings: ($unresolved | map(. + ": wp-config.php names DB_NAME without a literal database name, so the database it owns cannot be read from the file and may be listed here; until then only a lane database with a test options table counts as throwaway")),
			runs: $runs }'
}

# write_settings <json> : atomic replace of $DATA_DIR/cleanup.json.
write_settings() {
	local tmp
	mkdir -p "$DATA_DIR"
	tmp="$(mktemp "$DATA_DIR/cleanup.json.XXXXXX")"
	printf '%s\n' "$1" > "$tmp" && mv "$tmp" "$STATE_FILE"
}

# pin_main : --pin / --unpin. Idempotent; needs no MySQL.
pin_main() {
	local s t
	s="$(settings_json)"
	for t in "${TARGETS[@]}"; do
		valid_name "$t" || die "bad name: $t"
		if [ "pin" = "$ACTION" ]; then s="$(jq -c --arg t "$t" '.pinned = ((.pinned + [$t]) | unique)' <<<"$s")"
		else s="$(jq -c --arg t "$t" '.pinned = (.pinned - [$t])' <<<"$s")"; fi
	done
	write_settings "$s"
	if [ "1" = "$JSON" ]; then jq -c '{pinned: .pinned}' <<<"$s"; else jq -r '"pinned: " + (.pinned | join(", "))' <<<"$s"; fi
}

# dump_db <db> : compressed dump under $BACKUP_ROOT/_dropped/<stamp>/; fails when it is empty.
dump_db() {
	local dir="$BACKUP_ROOT/_dropped/$STAMP" f
	mkdir -p "$dir"
	f="$dir/$1.sql.zst"
	mysqldump_new --single-transaction --routines --events --triggers "$1" 2> /dev/null | zstd -q -f -o "$f" && [ -s "$f" ]
}

# drop_main : --drop. The guard runs on a fresh scan, so a database written to after the listing a person looked at is
# refused. A target is a database name or a run tag (all its lanes). Owned, locked and pinned are refused; a run with
# any locked lane is refused whole. A target that matches nothing is reported as already gone (a rerun is not an error).
drop_main() {
	local scan owned t run reason kind dbs db bytes result
	local dropped='[]' refused='[]' gone='[]' freed=0
	local lock_wait="${CLEANUP_LOCK_WAIT:-30}"
	[[ "$lock_wait" =~ ^[1-9][0-9]*$ ]] || lock_wait=30
	STAMP="$(date +%Y%m%d-%H%M%S)"
	scan="$(scan_json)" || die "cleanup: could not read the databases; nothing was dropped"
	owned="$(owned_dbs)" || die "cleanup: could not read the sites' databases; nothing was dropped"
	for t in "${TARGETS[@]}"; do
		if ! valid_name "$t"; then
			refused="$(jq -c --arg n "$t" '. + [{name: $n, reason: "bad_name"}]' <<<"$refused")"; continue
		fi
		# The run lookup comes first: owned databases never appear in the scan, so a run whose tag equals an owned database's
		# name (lanes of site_x next to the site's own site_x) is still droppable, and the owned database stays untouched.
		run="$(jq -c --arg t "$t" '[.runs[] | select(.tag == $t or ((.databases | index($t)) != null))] | first // empty' <<<"$scan")"
		if [ -z "$run" ]; then
			if printf '%s\n' "$owned" | grep -Fx -- "$t" > /dev/null; then
				refused="$(jq -c --arg n "$t" '. + [{name: $n, reason: "owned"}]' <<<"$refused")"
			else
				gone="$(jq -c --arg n "$t" '. + [$n]' <<<"$gone")"
			fi
			continue
		fi
		reason="$(jq -r 'if .pinned then "pinned" elif .state == "locked" then "locked" else "" end' <<<"$run")"
		if [ -n "$reason" ]; then
			refused="$(jq -c --arg n "$t" --arg r "$reason" '. + [{name: $n, reason: $r}]' <<<"$refused")"; continue
		fi
		kind="$(jq -r '.kind' <<<"$run")"
		if [ "true" = "$(jq -r --arg t "$t" '.tag == $t' <<<"$run")" ]; then dbs="$(jq -r '.databases[]' <<<"$run")"; else dbs="$t"; fi
		while IFS= read -r db; do
			bytes="$(files_bytes "$db")"
			if [ "1" != "$DRY_RUN" ]; then
				if [ "throwaway" != "$kind" ] && ! dump_db "$db"; then
					refused="$(jq -c --arg n "$db" '. + [{name: $n, reason: "dump_failed"}]' <<<"$refused")"; continue
				fi
				# Checked by hand (errexit is off here). The lock wait is short so a client that grabbed a table between the
				# guard and the DROP fails the DROP instead of blocking for the server's default of a year.
				if ! mysql_new -e "SET SESSION lock_wait_timeout = $lock_wait; DROP DATABASE \`$db\`" < /dev/null 2> /dev/null; then
					refused="$(jq -c --arg n "$db" '. + [{name: $n, reason: "drop_failed"}]' <<<"$refused")"; continue
				fi
			fi
			dropped="$(jq -c --arg n "$db" --argjson b "$bytes" '. + [{name: $n, bytes: $b}]' <<<"$dropped")"
			freed=$((freed + bytes))
		done <<<"$dbs"
	done
	result="$(jq -n --argjson d "$dropped" --argjson r "$refused" --argjson g "$gone" --argjson f "$freed" \
		--argjson dry "$([ "1" = "$DRY_RUN" ] && echo true || echo false)" \
		'{dropped: $d, refused: $r, already_gone: $g, freed_bytes: $f, dry_run: $dry}')"
	RESULT="$result"
	if [ "1" = "$JSON" ]; then
		printf '%s\n' "$result"
	else
		jq -r '(.dropped[] | "\(if $dry then "would drop" else "dropped" end) \(.name) (\(.bytes / 1048576 | floor) MB)"),
			(.refused[] | "refused \(.name): \(.reason)"), (.already_gone[] | "already gone: \(.)"),
			"freed \(.freed_bytes / 1048576 | floor) MB"' --argjson dry "$([ "1" = "$DRY_RUN" ] && echo true || echo false)" <<<"$result"
	fi
	[ "$(jq '.refused | length' <<<"$result")" -eq 0 ]
}

# settings_main : --enable-sweep / --disable-sweep / --older-than. Needs no MySQL.
settings_main() {
	local s
	s="$(settings_json)"
	if [ -n "$SET_ENABLED" ]; then s="$(jq -c --argjson e "$SET_ENABLED" '.sweep.enabled = $e' <<<"$s")"; fi
	if [ -n "$SET_HOURS" ]; then s="$(jq -c --argjson h "$SET_HOURS" '.sweep.older_than_hours = $h' <<<"$s")"; fi
	write_settings "$s"
	if [ "1" = "$JSON" ]; then jq -c '{sweep: .sweep}' <<<"$s"; else jq -r '"sweep " + (if .sweep.enabled then "on" else "off" end) + ", drops lane databases idle over \(.sweep.older_than_hours) h"' <<<"$s"; fi
}

require_mysql() {
	if mysql_new -e 'SELECT 1' > /dev/null 2>&1; then return 0; fi
	if [ "1" = "$JSON" ]; then jq -n '{error: "mysql not answering"}'; else log "cleanup: mysql not answering"; fi
	exit 1
}

# sweep_main : --sweep. Drops the runs the listing calls sweep.next (lane suffix + test options, idle past the threshold,
# unlocked, unpinned) through drop_main, so the guard is the one the tab and the CLI use, and logs each drop. Silent and
# inert while the switch is off, even without MySQL (--dry-run shows what it would do whatever the switch says).
sweep_main() {
	local enabled scan t lines
	enabled="$(settings_json | jq -r '.sweep.enabled')"
	if [ "true" != "$enabled" ] && [ "1" != "$DRY_RUN" ]; then return 0; fi
	require_mysql
	scan="$(scan_json)" || die "cleanup: could not read the databases; the sweep did nothing"
	TARGETS=()
	while IFS= read -r t; do
		if [ -n "$t" ]; then TARGETS+=("$t"); fi
	done < <(jq -r '.sweep.next[]' <<<"$scan")
	if [ "${#TARGETS[@]}" -eq 0 ]; then
		if [ "1" = "$JSON" ]; then
			jq -n --argjson dry "$([ "1" = "$DRY_RUN" ] && echo true || echo false)" '{dropped: [], refused: [], already_gone: [], freed_bytes: 0, dry_run: $dry}'
		fi
		return 0
	fi
	drop_main || true
	if [ "1" != "$DRY_RUN" ]; then
		lines="$(jq -r '.dropped[] | "\(now | todate) \(.name) \(.bytes)"' <<<"$RESULT")"
		if [ -n "$lines" ]; then mkdir -p "$LOG_DIR"; printf '%s\n' "$lines" >> "$LOG_DIR/cleanup-sweep.log"; fi
	fi
}

if [ "pin" = "$ACTION" ] || [ "unpin" = "$ACTION" ]; then pin_main; exit 0; fi
if [ "settings" = "$ACTION" ]; then settings_main; exit 0; fi
if [ "sweep" = "$ACTION" ]; then sweep_main; exit 0; fi

require_mysql

if [ "drop" = "$ACTION" ]; then
	if drop_main; then exit 0; else exit 1; fi
fi

out="$(scan_json)"
if [ "1" = "$JSON" ]; then
	printf '%s\n' "$out"
else
	jq -r '"\(.mysql.databases) databases, \(.mysql.unowned) not owned by a site; disk free \(.disk_free_bytes / 1073741824 | floor) GB; MySQL catalog \(.mysql.catalog_bytes / 1048576 | floor) MB (\(.mysql.catalog_free_bytes / 1048576 | floor) MB free)\n"' <<<"$out"
	jq -r '(["RUN", "LANES", "LOOKS", "LAST WRITE", "STATE", "MB"] | @tsv),
		(.runs[] | [.tag, .lanes, .kind, (.last_write // "-"), (if .pinned then "pinned" else .state end), (.files_bytes / 1048576 | floor)] | @tsv)' <<<"$out" | column -t -s $'\t'
fi
