#!/usr/bin/env bash
# stack-status : one JSON blob describing the local stack (polled by the future menu-bar app).
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

# Valet runs nginx/dnsmasq/php-fpm as root; mysql/mailpit run as the user. Merge both service domains.
services="$( { sudo -n brew services list --json 2> /dev/null || echo '[]'; brew services list --json 2> /dev/null || echo '[]'; } \
	| jq -s 'add | map(select(.name | test("^(nginx|dnsmasq|php(@[0-9.]+)?|mysql@8.4|mailpit|redis|memcached)$")))
	         | group_by(.name) | map(max_by(if .status == "started" then 1 else 0 end)) | map({name, status, user})')"

# PHP: one entry per installed version. fpm = brew service state; default = the version behind valet.sock;
# sites = isolated sites on that version (default version gets the non-isolated sites); xdebug = ini present.
default_sock="$(readlink "$VALET_HOME/valet.sock" 2> /dev/null | /usr/bin/grep -oE 'valet[0-9]+\.sock' || true)"
n_linked="$(ls "$VALET_HOME/Sites" 2> /dev/null | wc -l | tr -d ' ')"
n_isolated_total="$(/usr/bin/grep -lE 'valet[0-9]+\.sock' "$VALET_HOME"/Nginx/* 2> /dev/null | wc -l | tr -d ' ')"
php_json="$(for d in "$BREW_PREFIX"/etc/php/*/; do
	[ -d "$d/conf.d" ] || continue
	v="$(basename "$d")"; sock="valet${v/./}.sock"
	formula="php@$v"; [ -d "$BREW_PREFIX/opt/$formula" ] || formula="php"
	full="$("$BREW_PREFIX/opt/$formula/bin/php" -r 'echo PHP_VERSION;' 2> /dev/null || true)"
	is_default=false; [ "$sock" = "$default_sock" ] && is_default=true
	iso="$(/usr/bin/grep -l "$sock" "$VALET_HOME"/Nginx/* 2> /dev/null | wc -l | tr -d ' ')"
	if [ "true" = "$is_default" ]; then sites=$(( n_linked - n_isolated_total )); else sites="$iso"; fi
	xd=false; [ -f "$d/conf.d/20-xdebug.ini" ] && xd=true
	fpm="$(echo "$services" | jq -r --arg f "$formula" '.[] | select(.name == $f) | .status' | head -1)"
	jq -n --arg v "$v" --arg full "$full" --arg formula "$formula" --arg fpm "${fpm:-none}" --argjson default "$is_default" --argjson sites "$sites" --argjson xdebug "$xd" \
		'{version:$v,full:$full,formula:$formula,fpm:$fpm,default:$default,sites:$sites,xdebug:$xdebug}'
done | jq -s 'sort_by(.version)')"

today="$(date '+%d-%b-%Y')"; yday="$(date -v-1d '+%d-%b-%Y')"
# Disk: database bytes live from information_schema (one query), folder bytes from bin/site-sizes' nightly cache.
db_sizes="$(mysql_new -N -e "SELECT table_schema, COALESCE(SUM(data_length + index_length), 0) FROM information_schema.TABLES GROUP BY table_schema" 2> /dev/null \
	| jq -R 'split("\t") | select(length == 2) | {(.[0]): (.[1] | tonumber)}' | jq -s 'add // {}' 2> /dev/null || echo '{}')"
folder_sizes="$(jq -c '.' "$DATA_DIR/sizes.json" 2> /dev/null || echo '{"computed_at":null,"sites":{}}')"
favorites="$(jq -c '.favorites // []' "$DATA_DIR/settings.json" 2> /dev/null || echo '[]')"
sites="$(for l in "$VALET_HOME"/Sites/*; do
	[ -L "$l" ] || continue
	n="$(basename "$l")"; php=default
	conf="$VALET_HOME/Nginx/$n.$TLD"
	if [ -f "$conf" ]; then
		sock="$(grep -oE 'valet[0-9]+\.sock' "$conf" | head -1)"
		[ -n "$sock" ] && php="$(sed -E 's/valet([0-9])([0-9]+)\.sock/\1.\2/' <<<"$sock")"
	fi
	secured=false; [ -f "$VALET_HOME/Certificates/$n.$TLD.crt" ] && secured=true
	target="$(readlink "$l")"; wp=false; [ -f "$target/wp-config.php" ] && wp=true
	prot=false; is_protected "$n" && prot=true
	# PHP fatals WordPress logged today or yesterday (debug.log is rotated, so its tail is enough).
	fatals=0; dlog="$target/wp-content/debug.log"
	if [ -f "$dlog" ]; then fatals="$(tail -n 3000 "$dlog" | /usr/bin/grep -cE "^\[($today|$yday)[^]]*\] PHP (Fatal|Parse) error" || true)"; else dlog=""; fi
	ocache=""; if [ -f "$target/wp-content/object-cache.php" ]; then ocache="$(head -20 "$target/wp-content/object-cache.php" | grep -qi redis && echo redis || { head -20 "$target/wp-content/object-cache.php" | grep -qi memcache && echo memcached || echo other; })"; fi
	dbn=""; [ "true" = "$wp" ] && dbn="$(sed -nE "s/.*define\( *['\"]DB_NAME['\"], *['\"]([^'\"]+)['\"].*/\1/p" "$target/wp-config.php" 2> /dev/null | head -1 || true)"
	jq -n --arg name "$n" --arg php "$php" --argjson secured "$secured" --argjson wp "$wp" --arg path "$target" --argjson prot "$prot" --argjson fatals "${fatals:-0}" --arg dlog "$dlog" \
		--arg dbn "$dbn" --argjson dbs "$db_sizes" --argjson fs "$folder_sizes" --argjson favs "$favorites" --arg ocache "$ocache" \
		'{name:$name,php:$php,secured:$secured,wp:$wp,path:$path,protected:$prot,fatals_recent:$fatals,debug_log:(if $dlog == "" then null else $dlog end),
		  db:(if $dbn == "" then null else $dbn end), db_bytes:(if $dbn == "" then null else ($dbs[$dbn] // null) end), files_bytes:($fs.sites[$name] // null),
		  favorite:($favs | index($name) != null), object_cache:(if $ocache == "" then null else $ocache end)}'
done | jq -s 'sort_by(.name)')"

# Port owner: when several processes listen (Docker's *:6379 beside Homebrew's 127.0.0.1:6379), prefer the
# loopback-bound local one; normalise lsof's truncated names.
port_owner() {
	local names
	names="$(lsof -nP -iTCP:"$1" -sTCP:LISTEN 2> /dev/null | awk 'NR>1{print $1}' | sort -u)"
	local pick; pick="$(printf '%s\n' "$names" | /usr/bin/grep -v '^com\.docke' | head -1)"; [ -n "$pick" ] || pick="$(printf '%s\n' "$names" | head -1)"
	case "$pick" in redis-ser*) echo redis ;; com.docke*) echo docker ;; mysqld) echo mysql ;; *) echo "$pick" ;; esac
}
ports="$(for p in 80 443 3306 1025 8025 6379 11211; do
	owner="$(port_owner "$p")"
	jq -n --arg p "$p" --arg o "${owner:-}" '{($p): (if $o == "" then null else $o end)}'
done | jq -s 'add')"

mysql_json='{"version":null,"qps":null}'
if st="$("$BREW_PREFIX/opt/mysql@8.4/bin/mysqladmin" -uroot status 2> /dev/null)"; then
	up="$(sed -E 's/.*Uptime: ([0-9]+).*/\1/' <<<"$st")"; q="$(sed -E 's/.*Questions: ([0-9]+).*/\1/' <<<"$st")"
	v="$(mysql_new -N -e 'SELECT VERSION()')"
	mysql_json="$(jq -n --arg v "$v" --argjson qps "$(awk -v q="$q" -v u="$up" 'BEGIN{printf "%.2f", (u>0)?q/u:0}')" '{version:$v,qps:$qps}')"
fi

# Mail catcher on :8025 — Mailpit (/api/v1) or MAMP's MailHog (served under /mailhog).
mail_json='{"backend":null,"total":null}'
if t="$(curl -s -m 1 'http://localhost:8025/api/v1/messages?limit=1' | jq -e '.total' 2> /dev/null)"; then
	mail_json="$(jq -n --argjson t "$t" '{backend:"mailpit",total:$t}')"
elif t="$(curl -s -m 1 'http://localhost:8025/mailhog/api/v2/messages?limit=1' | jq -e '.total' 2> /dev/null)"; then
	mail_json="$(jq -n --argjson t "$t" '{backend:"mailhog",total:$t}')"
fi

# Homebrew upgrade state written by bin/stack-upgrade (nightly --auto, or on demand); no network here.
upgrades="$(jq -c '.' "$DATA_DIR/upgrades.json" 2> /dev/null || echo null)"
# What the five-minute watchdog last did (bin/watchdog).
watchdog="$(jq -c '.' "$DATA_DIR/watchdog.json" 2> /dev/null || echo null)"
# Public tunnel (bin/site-share): only while its process is alive.
share=null; if p="$(jq -r '.pid // empty' "$DATA_DIR/share.json" 2> /dev/null)" && [ -n "$p" ] && kill -0 "$p" 2> /dev/null; then share="$(jq -c '.' "$DATA_DIR/share.json")"; fi

jq -n --argjson services "$services" --argjson php "$php_json" --argjson sites "$sites" --argjson ports "$ports" --argjson mysql "$mysql_json" --argjson mail "$mail_json" --argjson upgrades "$upgrades" --argjson watchdog "$watchdog" --argjson fs "$folder_sizes" --argjson share "$share" \
	'{generated_at: (now | todate), services:$services, php:$php, sites:$sites, ports:$ports, mysql:$mysql, mail:$mail, upgrades:$upgrades, watchdog:$watchdog, share:$share,
	  sizes:{computed_at:$fs.computed_at, files_total:([$sites[].files_bytes // 0] | add), db_total:([$sites[].db_bytes // 0] | add)}}'
