#!/usr/bin/env bash
# site-remove <name> --yes [--backup [--compress]] [--keep-files] [--keep-db]
# Unsecure + unlink from Valet, drop the site's database and DB user (read from wp-config), delete the folder.
# --backup runs site-backup first and aborts if that fails (what the menu-bar app does by default).
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

NAME="" ; YES=0 ; BACKUP=0 ; COMPRESS=0 ; KEEP_FILES=0 ; KEEP_DB=0
for arg in "$@"; do
	case "$arg" in
		--yes) YES=1 ;; --backup) BACKUP=1 ;; --compress) COMPRESS=1 ;; --keep-files) KEEP_FILES=1 ;; --keep-db) KEEP_DB=1 ;;
		--*) die "unknown flag $arg" ;;
		*) NAME="$arg" ;;
	esac
done
[ -n "$NAME" ] || die "usage: site-remove <name> --yes [--backup] [--keep-files] [--keep-db]"
[ "1" = "$YES" ] || die "refusing without --yes (this deletes the folder and the database)"
is_protected "$NAME" && die "$NAME is a PROTECTED site in sites.tsv; not removing"
SITE_PATH="$(readlink "$VALET_HOME/Sites/$NAME" 2> /dev/null || echo "$SITES_DIR/$NAME")"
log "=== site-remove $NAME ($SITE_PATH)"
if [ "1" = "$BACKUP" ]; then
	"$REPO_DIR/bin/site-backup" "$NAME" $([ "1" = "$COMPRESS" ] && echo --compress) > /dev/null || die "backup failed; nothing was removed"
fi

if [ "1" != "$KEEP_DB" ]; then
	php="$(site_php "$SITE_PATH")"
	db=""; user=""
	if [ -f "$SITE_PATH/wp-config.php" ]; then
		db="$(wp_site "$php" "$SITE_PATH" config get DB_NAME 2> /dev/null || true)"
		user="$(wp_site "$php" "$SITE_PATH" config get DB_USER 2> /dev/null || true)"
	fi
	# Sites created by site-new/site-import follow wp_<name>; fall back to that when wp-config is missing (half-finished create).
	[ -n "$db" ] || db="$(db_name_for "$NAME")"
	[ -n "$user" ] || user="$db"
	if [ -n "$db" ]; then mysql_new -e "DROP DATABASE IF EXISTS \`$(printf '%s' "$db" | sed 's/`/``/g')\`"; log "dropped database $db"; fi
	if [ -n "$user" ] && [ "root" != "$user" ] && [ "wp_root_user" != "$user" ]; then
		u="$(sql_quote "$user")"; mysql_new -e "DROP USER IF EXISTS '$u'@'localhost', '$u'@'127.0.0.1'"; log "dropped user $user"
	fi
fi
[ -f "$VALET_HOME/Certificates/$NAME.$TLD.crt" ] && { valet unsecure "$NAME" > /dev/null 2>&1 || true; log "unsecured"; }
[ -L "$VALET_HOME/Sites/$NAME" ] && { valet unlink "$NAME" > /dev/null 2>&1 || rm -f "$VALET_HOME/Sites/$NAME"; log "unlinked"; }
rm -f "$VALET_HOME/Nginx/$NAME.$TLD" 2> /dev/null || true
if [ "1" != "$KEEP_FILES" ] && [ -d "$SITE_PATH" ]; then rm -rf "$SITE_PATH"; log "deleted $SITE_PATH"; fi
log "done"
