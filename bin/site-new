#!/usr/bin/env bash
# site-new <name> [--php 8.4|7.4] [--empty] [--title "T"] [--admin-user U] [--admin-email E] [--json]
# Fresh WordPress at https://<name>.test with its own DB + DB user, HTTPS, local-SSL mu-plugin. --empty: bare linked folder.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

NAME="" ; PHPV="$DEFAULT_PHP" ; EMPTY=0 ; TITLE="" ; ADMIN_USER="admin" ; ADMIN_EMAIL="admin@example.test" ; JSON=0
while [ $# -gt 0 ]; do
	case "$1" in
		--php) PHPV="$2"; shift ;; --php=*) PHPV="${1#--php=}" ;;
		--empty) EMPTY=1 ;;
		--title) TITLE="$2"; shift ;;
		--admin-user) ADMIN_USER="$2"; shift ;;
		--admin-email) ADMIN_EMAIL="$2"; shift ;;
		--json) JSON=1 ;;
		--*) die "unknown flag $1" ;;
		*) NAME="$1" ;;
	esac
	shift
done
[ -n "$NAME" ] || die "usage: site-new <name> [--php 8.4|7.4] [--empty] [--title T] [--admin-user U] [--admin-email E] [--json]"
[[ "$NAME" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "name must be lowercase letters, digits and dashes"
case "$PHPV" in php@*) ;; *) PHPV="php@$PHPV" ;; esac
[ -x "$(php_bin "$PHPV")" ] || die "$PHPV is not installed (brew install $PHPV)"
SITE_PATH="$SITES_DIR/$NAME"; URL="https://$NAME.$TLD"
[ ! -e "$SITE_PATH" ] || die "$SITE_PATH already exists"
[ ! -L "$VALET_HOME/Sites/$NAME" ] || die "Valet already has a site named $NAME"
mkdir -p "$LOG_DIR"; exec 2> >(tee -a "$LOG_DIR/site-new-$NAME.log" >&2)
log "=== site-new $NAME ($PHPV, empty=$EMPTY)"

mkdir -p "$SITE_PATH"
ADMIN_PASS=""; DB_NAME=""; DB_USER=""
if [ "1" = "$EMPTY" ]; then
	printf '<?php\nphpinfo();\n' > "$SITE_PATH/index.php"
	log "empty site: index.php placeholder"
else
	wp() { wp_site "$PHPV" "$SITE_PATH" "$@"; }
	DB_NAME="$(db_name_for "$NAME")"; DB_USER="$DB_NAME"; DB_PASS="$(random_secret 20)"; ADMIN_PASS="$(random_secret 16)"
	[ -n "$TITLE" ] || TITLE="$NAME"
	log "downloading WordPress"
	wp core download --quiet
	mysql_new -e "CREATE DATABASE IF NOT EXISTS \`$DB_NAME\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci"
	db_ensure_user "$DB_NAME" "$DB_USER" "$DB_PASS"
	wp config create --dbname="$DB_NAME" --dbuser="$DB_USER" --dbpass="$DB_PASS" --dbhost=127.0.0.1 --dbcharset=utf8mb4 --quiet \
		--extra-php <<'PHP'
define( 'WP_DEBUG', true );
define( 'WP_DEBUG_LOG', true );
define( 'WP_DEBUG_DISPLAY', false );
define( 'WP_ENVIRONMENT_TYPE', 'local' );
PHP
	wp core install --url="$URL" --title="$TITLE" --admin_user="$ADMIN_USER" --admin_password="$ADMIN_PASS" --admin_email="$ADMIN_EMAIL" --skip-email --quiet
	wp rewrite structure '/%postname%/' --quiet 2> /dev/null || true
	log "WordPress $(wp core version) installed, db=$DB_NAME"
fi

site_finalize "$NAME" "$SITE_PATH" "$PHPV" || true
if [ "1" = "$JSON" ]; then
	jq -n --arg name "$NAME" --arg url "$URL" --arg php "$PHPV" --arg path "$SITE_PATH" --arg db "$DB_NAME" --arg dbuser "$DB_USER" \
		--arg admin "$ADMIN_USER" --arg pass "$ADMIN_PASS" --argjson smoke "$SMOKE_JSON" \
		'{name:$name,url:$url,php:$php,path:$path,db:$db,db_user:$dbuser,admin_user:$admin,admin_password:$pass,smoke:$smoke,ok:$smoke.ok}'
else
	echo "$URL"; [ -z "$ADMIN_PASS" ] || echo "wp-admin: $ADMIN_USER / $ADMIN_PASS   (shown once)"
fi
[ "true" = "$(jq -r .ok <<<"$SMOKE_JSON")" ]
