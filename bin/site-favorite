#!/usr/bin/env bash
# site-favorite <name> [on|off|toggle] [--json]   |   site-favorite --list [--json]
# Favourite sites sort to the top of the Sites list in the app and on the dashboard. Stored in
# $DATA_DIR/settings.json ("favorites"), read by stack-status as sites[].favorite.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

NAME="" ; OP="toggle" ; JSON=0 ; LIST=0
for arg in "$@"; do
	case "$arg" in
		on|off|toggle) OP="$arg" ;; --list) LIST=1 ;; --json) JSON=1 ;;
		--*) die "unknown flag $arg" ;;
		*) NAME="$arg" ;;
	esac
done
SETTINGS="$DATA_DIR/settings.json"; mkdir -p "$DATA_DIR"
[ -f "$SETTINGS" ] || echo '{}' > "$SETTINGS"
current="$(jq -c '.favorites // []' "$SETTINGS")"

if [ "1" = "$LIST" ]; then
	if [ "1" = "$JSON" ]; then echo "$current"; else jq -r '.[]' <<<"$current"; fi
	exit 0
fi
[ -n "$NAME" ] || die "usage: site-favorite <name> [on|off|toggle] | --list"
[ -L "$VALET_HOME/Sites/$NAME" ] || die "unknown site '$NAME'"
has="$(jq --arg n "$NAME" 'index($n) != null' <<<"$current")"
case "$OP" in
	on) want=true ;; off) want=false ;;
	toggle) [ "true" = "$has" ] && want=false || want=true ;;
esac
if [ "true" = "$want" ]; then new="$(jq -c --arg n "$NAME" '(. + [$n]) | unique' <<<"$current")"; else new="$(jq -c --arg n "$NAME" 'map(select(. != $n))' <<<"$current")"; fi
jq --argjson f "$new" '.favorites = $f' "$SETTINGS" > "$SETTINGS.tmp" && mv "$SETTINGS.tmp" "$SETTINGS"
if [ "1" = "$JSON" ]; then jq -n --arg n "$NAME" --argjson fav "$want" --argjson all "$new" '{name:$n,favorite:$fav,favorites:$all,ok:true}'
else echo "$NAME: $([ "true" = "$want" ] && echo favourite || echo 'not a favourite')"; fi
