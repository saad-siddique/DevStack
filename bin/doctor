#!/usr/bin/env bash
# doctor [--fix] [--json] : one pass over everything that can silently break the stack, with the fix for each finding.
# Exit 0 when all green, 1 when something needs attention. Read-only unless --fix, which runs the safe fixes
# (start a service, re-run bootstrap for missing drop-ins, links and agents) and checks again.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"
JSON=0; FIX=0
for arg in "$@"; do case "$arg" in --json) JSON=1 ;; --fix) FIX=1 ;; *) die "usage: doctor [--fix] [--json]" ;; esac; done

checks='[]'
add() { # add <ok|warn|fail> <name> <detail> [fix text] [auto command]
	checks="$(jq -c --arg s "$1" --arg n "$2" --arg d "$3" --arg f "${4:-}" --arg a "${5:-}" '. + [{status:$s,name:$n,detail:$d,fix:(if $f == "" then null else $f end),auto:(if $a == "" then null else $a end)}]' <<<"$checks")"
}
auto_svc() { printf '%s/bin/service %s start' "$REPO_DIR" "$1"; }   # the auto command for "start this service"
auto_boot() { printf '%s/bootstrap.sh' "$REPO_DIR"; }
services="$( { sudo -n brew services list --json 2> /dev/null || echo '[]'; brew services list --json 2> /dev/null || echo '[]'; } | jq -s 'add')"
svc_status() { jq -r --arg n "$1" '[.[] | select(.name == $n)] | max_by(if .status == "started" then 1 else 0 end) | .status // "none"' <<<"$services"; }

# --- DNS and web
if [ -f /etc/resolver/$TLD ]; then add ok "resolver" "/etc/resolver/$TLD present"; else add fail "resolver" "/etc/resolver/$TLD missing" "valet install"; fi
if [ "started" = "$(svc_status dnsmasq)" ]; then add ok "dnsmasq" "running"; else add fail "dnsmasq" "status $(svc_status dnsmasq)" "devstack service dnsmasq start" "$(auto_svc dnsmasq)"; fi
ip="$(dscacheutil -q host -a name "doctor-probe.$TLD" 2> /dev/null | awk '/ip_address/{print $2}' | head -1 || true)"
if [ "127.0.0.1" = "$ip" ]; then add ok "dns" "*.$TLD resolves to 127.0.0.1"; else add fail "dns" "doctor-probe.$TLD resolves to '${ip:-nothing}'" "devstack service dnsmasq restart (then check /etc/resolver/$TLD)"; fi
if [ "started" = "$(svc_status nginx)" ]; then add ok "nginx" "running"; else add fail "nginx" "status $(svc_status nginx)" "devstack service nginx start; devstack logs nginx" "$(auto_svc nginx)"; fi
# nginx -t without root still parses everything; only the root-owned pid file trips it afterwards. Judge the syntax line.
out="$("$BREW_PREFIX/bin/nginx" -t -e stderr 2>&1 || true)"
emerg="$(grep '\[emerg\]' <<<"$out" | grep -v 'nginx.pid' | head -1 || true)"
if grep -q 'syntax is ok' <<<"$out" && [ -z "$emerg" ]; then add ok "nginx config" "syntax ok"
else add fail "nginx config" "${emerg:-$(tail -1 <<<"$out")}" "fix the conf under ~/.config/valet/Nginx, then devstack service nginx restart"; fi
# By executable path, not name: LocalWP's router is an nginx too, on *:80/443, and Valet's more specific 127.0.0.1
# listener takes the loopback traffic, so LocalWP's *.local sites get Valet's 404.
for p in 80 443; do
	bins="$(lsof -nP -iTCP:$p -sTCP:LISTEN -t 2> /dev/null | sort -u | while read -r pid; do lsof -a -p "$pid" -d txt -Fn 2> /dev/null | sed -n 's/^n//p' | head -1; done | sort -u || true)"
	others="$(grep -v "^$BREW_PREFIX/" <<<"$bins" | grep . || true)"
	if [ -z "$bins" ]; then add fail "port $p" "nothing listening" "devstack service nginx start"
	elif [ -z "$others" ]; then add ok "port $p" "nginx (Homebrew)"
	elif grep -q 'lightning-services' <<<"$others"; then add fail "port $p" "LocalWP's router nginx also listens here" "in Local: Preferences > Advanced > Router Mode: localhost (or quit Local)"
	else add fail "port $p" "held by $(while IFS= read -r l; do basename "$l"; done <<<"$others" | sort -u | paste -sd, -) ($(head -1 <<<"$others"))" "quit it (MAMP? Docker?) then devstack service nginx restart"; fi
done

# --- PHP
default_sock="$(readlink "$VALET_HOME/valet.sock" 2> /dev/null || true)"
# (readlink already tolerant)
[ -n "$default_sock" ] && add ok "default php" "valet.sock -> $(basename "$default_sock")" || add fail "default php" "no ~/.config/valet/valet.sock" "valet use ${DEFAULT_PHP} --force"
for d in "$BREW_PREFIX"/etc/php/*/; do
	v="$(basename "$d")"; formula="php@$v"; [ -d "$BREW_PREFIX/opt/$formula" ] || formula="php"
	used="$(/usr/bin/grep -l "valet${v/./}.sock" "$VALET_HOME"/Nginx/* 2> /dev/null | wc -l | tr -d ' ' || true)"
	[ "valet${v/./}.sock" = "$(basename "$default_sock")" ] && used="default"
	st="$(svc_status "$formula")"
	if [ "0" != "$used" ] && [ "started" != "$st" ]; then add fail "php-fpm $v" "sites use it ($used) but php-fpm is $st" "devstack service php@$v start" "$(auto_svc "php@$v")"
	elif [ "started" = "$st" ] && [ ! -S "$VALET_HOME/valet${v/./}.sock" ]; then add fail "php-fpm $v" "running but no socket valet${v/./}.sock" "devstack service php@$v restart; devstack logs php-fpm"
	elif [ "started" = "$st" ]; then add ok "php-fpm $v" "running, $([ default = "$used" ] && echo default || echo "$used isolated sites")"
	else add ok "php-fpm $v" "off (no sites)"; fi
	broken="$(php_broken_ext "$BREW_PREFIX/opt/$formula/bin/php" | paste -sd' ' -)"
	[ -z "$broken" ] || add fail "php $v extensions" "$broken fail to load (built against another PHP $v build)" "devstack php-repair $v" "$REPO_DIR/bin/php-repair $v"
	[ -f "$d/conf.d/zz-uo-dev.ini" ] || add warn "php $v ini" "zz-uo-dev.ini drop-in missing" "./bootstrap.sh" "$(auto_boot)"
	[ -f "$d/php-fpm.d/zz-devstack.conf" ] || add warn "php $v pool" "pool guard drop-in missing (5 workers, no request timeout)" "./bootstrap.sh" "$(auto_boot)"
done
n_max="$(cat "$BREW_PREFIX"/var/log/php-fpm.log "$VALET_HOME"/Log/php-fpm.log 2> /dev/null | grep -c 'max_children' || true)"
[ "${n_max:-0}" -gt 0 ] && add warn "php-fpm workers" "pool hit pm.max_children $n_max time(s) in the current logs" "raise pm.max_children in php/zz-devstack-fpm.conf, ./bootstrap.sh"

# --- data services
if "$BREW_PREFIX/opt/mysql@8.4/bin/mysqladmin" -uroot ping > /dev/null 2>&1; then
	add ok "mysql" "answers on 3306 as root"
	lb="$(mysql_new -N -e 'SELECT @@log_bin' 2> /dev/null || true)"; [ "0" = "$lb" ] && add ok "mysql binlog" "off" || add warn "mysql binlog" "binary logging on (burns disk and writes locally)" "./bootstrap.sh (installs mysql/zz-devstack.cnf)"
else add fail "mysql" "not answering" "devstack service mysql@8.4 start; devstack logs mysql" "$(auto_svc mysql@8.4)"; fi
if curl -s -m 2 http://localhost:8025/api/v1/info > /dev/null; then add ok "mailpit" "UI on 8025"; else add warn "mailpit" "no answer on 8025 (sites' mail is lost)" "devstack service mailpit start" "$(auto_svc mailpit)"; fi
if "$BREW_PREFIX/bin/redis-cli" -h 127.0.0.1 ping 2> /dev/null | grep -q PONG; then add ok "redis" "PONG on 127.0.0.1:6379"; else add warn "redis" "no PONG" "devstack service redis start" "$(auto_svc redis)"; fi
if printf 'version\r\nquit\r\n' | nc -w1 127.0.0.1 11211 2> /dev/null | grep -q VERSION; then add ok "memcached" "answers on 11211"; else add warn "memcached" "no answer on 11211" "devstack service memcached start" "$(auto_svc memcached)"; fi
jq -r '.[] | select(.status | test("^error")) | .name' <<<"$services" | while read -r n; do [ -n "$n" ] && add fail "launchd" "$n reports error" "devstack service $n restart; devstack logs $n"; done

# --- certificates (Valet signs sites for ~1 year)
soon=0; expired=0
for c in "$VALET_HOME"/Certificates/*.crt; do
	[ -f "$c" ] || continue
	if ! openssl x509 -in "$c" -noout -checkend 0 > /dev/null 2>&1; then expired=$((expired+1))
	elif ! openssl x509 -in "$c" -noout -checkend $((30*86400)) > /dev/null 2>&1; then soon=$((soon+1)); fi
done
if [ "$expired" -gt 0 ]; then add fail "certificates" "$expired expired" "valet secure <site> for each (renews)"; elif [ "$soon" -gt 0 ]; then add warn "certificates" "$soon expire within 30 days" "valet secure <site> renews it"; else add ok "certificates" "none expiring within 30 days"; fi

# --- plumbing
sudo -n -l "$VALET_BIN" > /dev/null 2>&1 && add ok "sudoers" "valet + brew trusted (no password prompts)" || add fail "sudoers" "valet trust missing" "valet trust"
[ "$(readlink "$BREW_PREFIX/bin/devstack" 2> /dev/null)" = "$REPO_DIR/bin/devstack" ] && add ok "devstack link" "$BREW_PREFIX/bin/devstack -> this repo" || add warn "devstack link" "points elsewhere or missing" "./bootstrap.sh" "$(auto_boot)"
if [ "$(readlink "$DATA_DIR/bin/wp" 2> /dev/null)" != "$REPO_DIR/shims/wp" ]; then add warn "wp shim" "$DATA_DIR/bin/wp missing (wp runs the default PHP in every site)" "./bootstrap.sh" "$(auto_boot)"
elif ! grep -qF '.local/share/devstack/bin' "$HOME/.zshrc" 2> /dev/null; then add warn "wp shim" "not on PATH in ~/.zshrc" "./bootstrap.sh, then open a new terminal" "$(auto_boot)"
else add ok "wp shim" "wp follows each site's PHP"; fi
for a in logs-prune upgrade watchdog; do launchctl print "gui/$(id -u)/com.devstack.$a" > /dev/null 2>&1 && add ok "agent $a" "loaded" || add warn "agent $a" "LaunchAgent not loaded" "./bootstrap.sh" "$(auto_boot)"; done
free_gb="$(df -g "$HOME" | awk 'NR==2{print $4}')"
# Valet runs php-fpm, nginx and dnsmasq as root, and brew services then makes their bin/ root-owned; brew cleanup
# cannot delete those old builds after an upgrade without sudo.
stale="$(HOMEBREW_NO_AUTO_UPDATE=1 "$BREW_PREFIX/bin/brew" cleanup -n 2> /dev/null | sed -nE "s#^Would remove: ($BREW_PREFIX/Cellar/[^ ]+) .*#\\1#p" \
	| while IFS= read -r k; do [ -n "$(find "$k" -maxdepth 1 -user root 2> /dev/null)" ] && echo "$k"; done || true)"
if [ -n "$stale" ]; then
	add warn "old builds" "$(wc -l <<<"$stale" | tr -d ' ') old PHP/nginx build(s), $(du -sch $stale 2> /dev/null | tail -1 | cut -f1), are root-owned so brew cleanup skips them" "sudo rm -rf $(paste -sd' ' - <<<"$stale")"
fi
[ "${free_gb:-0}" -ge 10 ] && add ok "disk" "${free_gb} GB free" || add warn "disk" "only ${free_gb} GB free" "devstack backups (delete old ones), brew cleanup, devstack logs-prune"
bk="$(du -sk "$HOME/Backups/DevStack" 2> /dev/null | cut -f1 || true)"; [ "${bk:-0}" -gt $((20*1024*1024)) ] && add warn "backups" "$((bk/1024/1024)) GB in ~/Backups/DevStack" "delete backups you no longer need"
[ -f "$HOME/Sites/wp-config.php" ] && add fail "stray wp-config" "~/Sites/wp-config.php breaks wp config create for every site" "move it out of ~/Sites"
reports="$("$REPO_DIR/bin/logs" crashes --hours 24 --json 2> /dev/null || echo '{}')"
nc="$(jq -r '.crashes // 0' <<<"$reports")"; nr="$(jq -r '.resource // 0' <<<"$reports")"
[ "$nc" -gt 0 ] && add fail "crashes" "$nc crash report(s) in 24 h: $(jq -r '[.reports[] | select(.kind == "crash") | .process] | unique | join(", ")' <<<"$reports")" "devstack logs crashes; devstack logs php-fpm"
[ "$nr" -gt 0 ] && add warn "resource reports" "$nr macOS resource report(s) in 24 h: $(jq -r '[.reports[] | select(.kind != "crash") | "\(.process) (\(.kind))"] | unique | join(", ")' <<<"$reports")" "devstack logs crashes"

n_fail="$(jq '[.[] | select(.status == "fail")] | length' <<<"$checks")"; n_warn="$(jq '[.[] | select(.status == "warn")] | length' <<<"$checks")"
if [ "1" = "$FIX" ]; then
	fixes="$(jq -r '[.[] | select(.status != "ok" and .auto != null) | .auto] | unique | .[]' <<<"$checks")"
	if [ -n "$fixes" ]; then
		while IFS= read -r cmd; do log "fix: $cmd"; bash -c "$cmd" > /dev/null 2>&1 || log "warning: fix failed: $cmd"; done <<<"$fixes"
		log "re-checking"; exec "$0" $([ "1" = "$JSON" ] && echo --json)
	else
		log "nothing auto-fixable"
	fi
fi
if [ "1" = "$JSON" ]; then
	jq -n --argjson c "$checks" --argjson f "$n_fail" --argjson w "$n_warn" '{checked_at:(now|todate), ok:($f == 0), failures:$f, warnings:$w, checks:$c}'
else
	jq -r '.[] | (if .status == "ok" then "  ✓ " elif .status == "warn" then "  ! " else "  ✗ " end) + .name + ": " + .detail + (if .fix then "\n        → " + .fix else "" end)' <<<"$checks"
	echo; [ "$n_fail" -eq 0 ] && echo "all good ($n_warn warning(s))" || echo "$n_fail problem(s), $n_warn warning(s)"
fi
[ "$n_fail" -eq 0 ]
