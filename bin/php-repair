#!/usr/bin/env bash
# php-repair <X.Y>
# Reinstalls PHP X.Y and every Homebrew extension built for it, from the current bottles, when extensions fail to
# load ("Unable to initialize module": the module API differs). The shivammathur taps rebuild pre-release PHP (8.6)
# without a version bump, so upgrading only an extension, or only PHP, leaves the two built against different APIs.
# Restarts that version's php-fpm afterwards when it was running. bin/stack-upgrade runs this after every upgrade.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

V="${1:-}"
[[ "$V" =~ ^[0-9]+\.[0-9]+$ ]] || die "usage: php-repair X.Y"
bin="$(php_bin "php@$V")"
[ -x "$bin" ] || die "php@$V is not installed"
broken="$(php_broken_ext "$bin" | paste -sd' ' -)"
if [ -z "$broken" ]; then log "php@$V: every extension loads"; exit 0; fi

formula="php@$V"; [ -d "$BREW_PREFIX/opt/$formula" ] || formula="php"   # the newest PHP is Homebrew's `php`
exts=(); while IFS= read -r f; do exts+=("$f"); done < <("$BREW_PREFIX/bin/brew" list --formula --full-name | grep -E "/[^/]+@$V\$" | grep -v "/php@$V\$" || true)
log "php@$V: $broken fail to load; reinstalling $formula ${exts[*]+${exts[*]}}"
HOMEBREW_NO_AUTO_UPDATE=1 "$BREW_PREFIX/bin/brew" reinstall "$formula" ${exts[@]+"${exts[@]}"} < /dev/null > /dev/null 2> >(grep -E '^Error' >&2) || true

broken="$(php_broken_ext "$bin" | paste -sd' ' -)"
[ -z "$broken" ] || die "php@$V: $broken still fail to load; see brew info $formula"
log "php@$V: every extension loads again"
if [ "started" = "$("$REPO_DIR/bin/service" "php@$V" status --json | jq -r .status)" ]; then
	"$REPO_DIR/bin/service" "php@$V" restart > /dev/null && log "restarted php@$V"
fi
