#compdef devstack
# zsh completion for devstack; bootstrap.sh links it into $(brew --prefix)/share/zsh/site-functions/.

_devstack_sites() { local -a s; s=( ${(f)"$(ls ~/.config/valet/Sites 2> /dev/null)"} ); _describe 'site' s; }
_devstack_php() {
	local -a v; v=( ${(f)"$(ls /opt/homebrew/etc/php 2> /dev/null)"} ); _describe 'php version' v
}

_devstack() {
	local -a cmds
	cmds=(
		'new:fresh WordPress site' 'import:import a LocalWP export, folder or backup' 'backup:back up a site'
		'backups:list or prune backups' 'archive:back up then remove a site' 'restore:recreate a site from its backup' 'clone:copy a site under a new name' 'remove:remove a site' 'watchdog:restart nginx/dnsmasq if lost' 'sizes:folder size per site' 'favorite:pin a site to the top' 'sites:list linked sites' 'login:open wp-admin signed in' 'php:switch a site PHP version' 'doctor:check the stack' 'open:open a site or tool in the browser'
		'migrate:migrate one MAMP host' 'migrate-all:migrate every non-protected host'
		'status:stack status JSON' 'service:start/stop/restart a service' 'xdebug:toggle Xdebug per PHP version'
		'logs:tail stack logs' 'logs-prune:rotate logs now'
		'bootstrap:(re)install the stack' 'update:git pull + bootstrap' 'upgrade:Homebrew upgrades of the stack' 'app:menu-bar app' 'path:print repo dir' 'help:usage'
	)
	if (( CURRENT == 2 )); then _describe 'command' cmds; return; fi
	case $words[2] in
		php) (( CURRENT == 3 )) && _devstack_sites || { local -a v; v=( default ${(f)"$(ls /opt/homebrew/etc/php 2> /dev/null)"} ); _describe 'php version' v; } ;;
		remove|rm|backup|migrate|login|archive|restore|clone) (( CURRENT == 3 )) && _devstack_sites || _arguments '--yes' '--backup' '--keep-files' '--keep-db' '--db-only' '--files-only' '--user' '--print' '--replace' '--from:dir:_files -/' '--php' '--compress' '--json' ;;
		sizes) _arguments '--refresh' '--json' ;;
		favorite|fav|star) (( CURRENT == 3 )) && _devstack_sites || { local -a o; o=( on off toggle ); _describe 'state' o; } ;;
		backups) (( CURRENT == 3 )) && { _devstack_sites; _arguments '--prune' '--delete:dir:_files -/'; } || _arguments '--keep' '--older-than' '--dry-run' '--json' ;;
		open) local -a t; t=( dashboard phpmyadmin mailpit ); _describe 'target' t; _devstack_sites ;;
		new) (( CURRENT == 3 )) || _arguments '--php[PHP version]:version:_devstack_php' '--empty' '--title' '--json' ;;
		import) (( CURRENT == 4 )) && _files || _arguments '--php[PHP version]:version:_devstack_php' '--sql:file:_files' '--json' ;;
		service|svc)
			if (( CURRENT == 3 )); then
				local -a s; s=( nginx dnsmasq mysql@8.4 mailpit redis memcached ${(f)"$(ls /opt/homebrew/etc/php 2> /dev/null | sed 's/^/php@/')"} ); _describe 'service' s
			else local -a o; o=( start stop restart status ); _describe 'operation' o; fi ;;
		xdebug) (( CURRENT == 3 )) && { local -a o; o=( on off status ); _describe 'operation' o; } || _arguments '--php[PHP version]:version:_devstack_php' '--json' ;;
		logs) local -a src; src=( list nginx php php-fpm mysql redis mailpit prune wp crashes clear ); (( CURRENT == 3 )) && _describe 'source' src || _devstack_sites ;;
		app) local -a a; a=( build install open uninstall status ); _describe 'action' a ;;
		bootstrap) _arguments '--app' ;;
		update) _arguments '--check' '--app' '--json' ;;
		upgrade) _arguments '--check' '--auto' '--all' '--nightly' '--set-auto:mode:(off patch all)' '--json' ;;
	esac
}
_devstack "$@"
